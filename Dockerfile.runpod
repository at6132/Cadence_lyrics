# RunPod serverless worker for the lyric pipeline.
# Build with your adapters included, or mount adapters at runtime.
# Base: CUDA + Python for transformers/bitsandbytes GPU inference.
FROM nvidia/cuda:12.1.0-cudnn8-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.10 \
    python3-pip \
    python3.10-venv \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3.10 /usr/bin/python \
    && ln -sf /usr/bin/python3.10 /usr/bin/python3

WORKDIR /app

# Install Python deps (long timeout for large wheels: torch, nvidia-*)
COPY requirements.txt requirements-runpod.txt ./
RUN python3 -m pip install --no-cache-dir --timeout 600 --retries 5 -r requirements-runpod.txt

# Copy full app (prompts, pipeline, generate, config, utils, data)
COPY config.py generate.py pipeline.py prompts.py phrase_blacklist.py scoring.py runpod_handler.py handler.py ./
COPY utils ./utils
COPY data ./data
# Adapter is NOT copied (too large for GitHub). At runtime set:
#   LYRIC_ADAPTER_REPO=your_hf_username/your-adapter-repo
#   HUGGING_FACE_HUB_TOKEN=hf_...  (for private repos)
# The handler downloads the adapter on first cold start. For local Docker with adapters on disk, add:
#   COPY adapters ./adapters
RUN mkdir -p /app/adapters/lyric-human

# HUGGING_FACE_HUB_TOKEN + LYRIC_ADAPTER_REPO: set in RunPod endpoint env.
# LYRIC_DEVICE=4xa100 for 70B preset.

# RunPod serverless runs the handler; it will load the model on first request
CMD ["python", "-u", "handler.py"]
